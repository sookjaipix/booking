  // Open Test URL in New Browser Tab
  const btnOpenInNewTab = document.getElementById('btnOpenInNewTab');
  if (btnOpenInNewTab) {
    btnOpenInNewTab.addEventListener('click', () => {
      const raw = gasUrlInput.value.trim();
