 */
function doPost(e) {
  e = e || { parameter: { action: 'ping' } };
  try {
    let payload = {};
    if (e && e.postData && e.postData.contents) {
      try {
        payload = JSON.parse(e.postData.contents);
      } catch (parseErr) {
        if (e.parameter && (e.parameter.payload || e.parameter.data)) {
