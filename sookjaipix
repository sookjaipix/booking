        }
      }
    } else if (e && e.parameter) {
      if (e.parameter.payload || e.parameter.data) {
        try {
          payload = JSON.parse(e.parameter.payload || e.parameter.data);
        } catch (pErr) {
          payload = e.parameter || {};
        }
      } else {
        payload = e.parameter || {};
      }
