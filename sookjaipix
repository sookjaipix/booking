  // Test GAS Connection
  btnTestGasConnection.addEventListener('click', async () => {
    const url = gasUrlInput.value.trim();
    if (!url) {
      alert('กรุณากรอก Google Apps Script Web App URL ก่อนทดสอบ');
      gasUrlInput.focus();
      return;
    }

    btnTestGasConnection.disabled = true;
